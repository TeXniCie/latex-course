Wiskunde kan inline
met \PYG{l+s}{\PYGZdl{}}\PYG{n+nb}{f}\PYG{o}{(}\PYG{n+nb}{x}\PYG{o}{)}\PYG{n+nb}{ }\PYG{o}{=}\PYG{n+nb}{ }\PYG{n+nv}{\PYGZbs{}int}\PYG{n+nb}{\PYGZus{}}\PYG{l+m}{0}\PYG{n+nb}{\PYGZca{}}\PYG{n+nb}{x y}\PYG{n+nb}{\PYGZca{}}\PYG{l+m}{2}\PYG{n+nb}{ dy}\PYG{l+s}{\PYGZdl{}}
of in een display met
\PYG{l+s+sb}{\PYGZbs{}[}\PYG{n+nb}{ f}\PYG{o}{(}\PYG{n+nb}{x}\PYG{o}{)}\PYG{n+nb}{ }\PYG{o}{=}\PYG{n+nb}{ }\PYG{n+nv}{\PYGZbs{}int}\PYG{n+nb}{\PYGZus{}}\PYG{l+m}{0}\PYG{n+nb}{\PYGZca{}}\PYG{n+nb}{x y}\PYG{n+nb}{\PYGZca{}}\PYG{l+m}{2}\PYG{n+nb}{ dy. }\PYG{l+s}{\PYGZbs{}]}
Alternatief kan inline wiskunde
ook met \PYG{l+s}{\PYGZbs{}(}\PYG{n+nb}{f}\PYG{o}{(}\PYG{n+nb}{x}\PYG{o}{)}\PYG{n+nb}{ }\PYG{o}{=}\PYG{n+nb}{ }\PYG{n+nv}{\PYGZbs{}frac}\PYG{n+nb}{\PYGZob{}}\PYG{l+m}{1}\PYG{n+nb}{\PYGZcb{}}\PYG{n+nb}{\PYGZob{}}\PYG{l+m}{3}\PYG{n+nb}{\PYGZcb{}}\PYG{n+nb}{x}\PYG{n+nb}{\PYGZca{}}\PYG{l+m}{3}\PYG{l+s}{\PYGZbs{})}
en een display kan ook met
\PYG{k}{\PYGZbs{}begin}\PYG{n+nb}{\PYGZob{}}equation\PYG{n+nb}{\PYGZcb{}}
    f(x) = \PYG{k}{\PYGZbs{}frac}\PYG{n+nb}{\PYGZob{}}1\PYG{n+nb}{\PYGZcb{}}\PYG{n+nb}{\PYGZob{}}3\PYG{n+nb}{\PYGZcb{}}x\PYG{n+nb}{\PYGZca{}}3
\PYG{k}{\PYGZbs{}end}\PYG{n+nb}{\PYGZob{}}equation\PYG{n+nb}{\PYGZcb{}}
\end{MintedVerbatim}
